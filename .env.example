# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
DCC_ADMIN_USERNAME=admin
DCC_ADMIN_PASSWORD=change-me-please
# openssl rand -hex 48  (leave empty to have one generated and stored in the data volume)
DCC_JWT_SECRET=
DCC_ALLOW_REGISTRATION=true
# true when the site is served over HTTPS
DCC_COOKIE_SECURE=false
# host port
DCC_PORT=8080
